class_name UiPalette
## The one palette the Sheets, the Instrument Panel, the Stamps and the Bands share, so the
## menus and the cockpit read as one game (docs/design.md, Presentation). Flat colours, like
## the models.

## Painted metal of the Instrument Panel's plate.
const OLIVE := Color(0.22, 0.25, 0.16)
const OLIVE_DARK := Color(0.14, 0.16, 0.10)
const OLIVE_LIGHT := Color(0.34, 0.38, 0.25)
## Webbing and worn edges.
const KHAKI := Color(0.62, 0.58, 0.42)
## Paper.
const CREAM := Color(0.93, 0.89, 0.76)
const CREAM_DARK := Color(0.85, 0.80, 0.65)
const CREAM_SHADE := Color(0.76, 0.71, 0.56)
## Typewriter ink.
const INK := Color(0.13, 0.12, 0.11)
const INK_FADED := Color(0.38, 0.36, 0.32)
## The rubber stamp.
const STAMP_RED := Color(0.72, 0.14, 0.12)
## Dial needles and hubs, bezels.
const BRASS := Color(0.76, 0.62, 0.32)
const BRASS_DARK := Color(0.45, 0.36, 0.18)
## The face of a dial.
const DIAL_FACE := Color(0.90, 0.87, 0.78)
## The warning lamp beside a dial, lit and dark.
const LAMP_ON := Color(1.0, 0.28, 0.2)
const LAMP_OFF := Color(0.33, 0.10, 0.08)
const RIVET := Color(0.46, 0.48, 0.38)
## The veil over the World behind a Sheet.
const DIM := Color(0.05, 0.05, 0.04, 0.3)
## The Band a mission message is set on.
const BAND := Color(0.14, 0.16, 0.10, 0.88)
